function ProjectCard({p,featured=false}:{p:Project;featured?:boolean}) {
  const destination = p.github || p.demo;
  const openProject = () => {
    if (destination) window.open(destination, '_blank', 'noopener,noreferrer');
  };
  return <article
    className={`project-card ${featured?'project-featured':''} ${destination?'has-repo':''}`}
    tabIndex={destination ? 0 : -1}
    role={destination ? 'link' : undefined}
    aria-label={destination ? `Open ${p.title} project` : p.title}
    onClick={openProject}
    onKeyDown={e => {
      if (destination && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        openProject();
      }
    }}
  >
    <Art p={p}/>
    <div className="project-info">
      <div className="project-overline">
        <span>{p.number} / {p.category}</span>
        <span className="project-arrow">↗</span>
      </div>
      <h3>{p.title}</h3>
      <p>{p.description}</p>
      <div className="tags">{p.stack.map(t=><span key={t}>{t}</span>)}</div>
      <div className="project-links">
        {p.github
          ? <a href={p.github} target="_blank" rel="noreferrer" onClick={e=>e.stopPropagation()}><Github size={15}/> Repository <ArrowUpRight size={14}/></a>
          : <span className="repo-note">Repository link not supplied</span>}
        {p.demo && <a className="demo" href={p.demo} target="_blank" rel="noreferrer" onClick={e=>e.stopPropagation()}>Live demo <ExternalLink size={14}/></a>}
      </div>
    </div>
  </article>;
}
